{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reel_spec.schema.json",
  "title": "Reel Studio reel spec",
  "description": "The single source of truth for one video. The AI writes this file; the engine renders it. The AI never writes scene code.",
  "type": "object",
  "required": ["id", "title", "format", "style", "channel", "brand", "facts", "cta", "beats"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{3,60}$" },
    "title": { "type": "string", "maxLength": 120 },
    "format": { "enum": ["how_it_works", "myth_buster", "case_study", "quick_tip", "explainer", "talking_head"] },
    "style": { "enum": ["print"] },
    "channel": { "enum": ["instagram", "linkedin", "youtube_shorts", "website"] },
    "brand": { "type": "string", "description": "Path to brand.json, relative to the project root" },
    "facts": { "type": "string", "description": "Path to the approved fact sheet, relative to the project root" },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Voiceover audio, relative to the project root" },
        "provider": { "type": "string" },
        "words": { "type": "string", "description": "Optional words.json with word timings for exact caption sync" }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.12 },
        "licence": { "type": "string" }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword", "line"],
      "properties": {
        "keyword": { "type": "string", "pattern": "^[A-Z0-9]{2,12}$" },
        "line": { "type": "string", "maxLength": 60 },
        "dm_link": { "type": "string" }
      }
    },
    "approvals": {
      "type": "object",
      "description": "Filled in by people, never by the AI",
      "properties": {
        "storyboard": { "$ref": "#/$defs/approval" },
        "final": { "$ref": "#/$defs/approval" }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "required": ["by", "date"],
      "properties": { "by": { "type": "string" }, "date": { "type": "string" }, "notes": { "type": "string" } }
    },
    "beat": {
      "type": "object",
      "required": ["id", "start", "end", "text", "scene", "props"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 140, "description": "Spoken line; shown as the kinetic caption" },
        "emphasis": { "type": "string", "description": "One word from text, styled as the accent word" },
        "chapter": { "type": "string", "maxLength": 40 },
        "progress": { "type": "string", "maxLength": 16, "description": "Top-right counter, e.g. STEP 2/4" },
        "theme": { "enum": ["light", "dark", "accent"], "default": "light" },
        "claims": { "type": "array", "items": { "type": "string" }, "description": "Fact sheet IDs this beat relies on" },
        "scene": { "enum": ["hook_title", "statement", "counter", "checklist", "myth_card", "cta"] },
        "props": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "scene": { "const": "hook_title" } } },
          "then": { "properties": { "props": { "required": ["title"], "additionalProperties": false,
            "properties": { "title": { "type": "string", "maxLength": 28 }, "tag": { "type": "string", "maxLength": 24 } } } } } },
        { "if": { "properties": { "scene": { "const": "statement" } } },
          "then": { "properties": { "props": { "required": ["title"], "additionalProperties": false,
            "properties": { "title": { "type": "string", "maxLength": 40 }, "sub": { "type": "string", "maxLength": 80 } } } } } },
        { "if": { "properties": { "scene": { "const": "counter" } } },
          "then": { "properties": { "props": { "required": ["value", "label"], "additionalProperties": false,
            "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 999999 },
                            "prefix": { "type": "string", "maxLength": 3 }, "suffix": { "type": "string", "maxLength": 4 },
                            "label": { "type": "string", "maxLength": 40 } } } } } },
        { "if": { "properties": { "scene": { "const": "checklist" } } },
          "then": { "properties": { "props": { "required": ["items"], "additionalProperties": false,
            "properties": { "title": { "type": "string", "maxLength": 30 },
                            "items": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "maxLength": 28 } } } } } } },
        { "if": { "properties": { "scene": { "const": "myth_card" } } },
          "then": { "properties": { "props": { "required": ["myth", "truth"], "additionalProperties": false,
            "properties": { "number": { "type": "integer", "minimum": 1, "maximum": 9 },
                            "myth": { "type": "string", "maxLength": 50 }, "truth": { "type": "string", "maxLength": 50 } } } } } },
        { "if": { "properties": { "scene": { "const": "cta" } } },
          "then": { "properties": { "props": { "additionalProperties": false,
            "properties": { "sub": { "type": "string", "maxLength": 60 } } } } } }
      ]
    }
  }
}
